# Copy to .env (optional). All values have safe defaults.

# SQLite database location (relative to the repository root)
# LEAD_CENTER_DATABASE_PATH=data/lead_center.db

# Public Overpass endpoint — prototype/P0 use only (see spec §5.1).
# LEAD_CENTER_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional contact appended to the Overpass User-Agent, e.g. an email or URL.
# LEAD_CENTER_OVERPASS_CONTACT=

# Hours an identical Overpass query is served from the local cache.
# LEAD_CENTER_OVERPASS_CACHE_TTL_HOURS=24
