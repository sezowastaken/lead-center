{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sandbox-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "python", "-m", "app.sandbox"],
      "port": 8001
    },
    {
      "name": "sandbox-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:sandbox"],
      "port": 5174
    }
  ]
}
